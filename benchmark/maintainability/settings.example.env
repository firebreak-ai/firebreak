# Copy to local/settings.env and fill in. NAME=value lines, absolute paths, no quotes. A variable set in the
# environment wins over this file.

# The SlopCodeBench problem set (https://github.com/SprocketLab/scb-problems): specs, hidden tests, reference solutions.
SCB_PROBLEMS=/path/to/scb-problems

# The Agentic Coding Lab (https://github.com/marcoemrich/agentic_coding_lab): the Python project skeleton and the EXACT
# and test-first workflows. The kit reads its experiments/ folder.
EXACT_LAB=/path/to/agentic_coding_lab

# The Firebreak version a Firebreak build installs: a commit of this repository (its assets/ folder is exported once
# to local/assets-<commit>), or the absolute path of an assets folder.
FBK_ASSETS=eddf9bb

# Optional. The folder that holds the sessions' work folders (default ~/.cache/wk).
#WORK=

# Optional. More places on this machine that hold answers or earlier runs, separated by spaces: lock.sh hides them
# with the rest and the audit counts a session naming one as naming an answer location.
#EXTRA_ANSWER_PATHS=
